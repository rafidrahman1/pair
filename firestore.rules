rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userPairId(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.pairId;
    }

    function isPairPartner(userId) {
      let myPairId = userPairId(request.auth.uid);
      let theirPairId = userPairId(userId);
      return myPairId != null &&
        theirPairId != null &&
        myPairId == theirPairId &&
        request.auth.uid != userId;
    }

    function isPairedMember(pairId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/pairs/$(pairId)).data.memberIds;
    }

    function hasNoPairId(data) {
      return !('pairId' in data) || data.pairId == null;
    }

    // Joiner must read the code owner's profile to verify they are still unpaired.
    function canReadUser(userId) {
      return isOwner(userId) ||
        isPairPartner(userId) ||
        (isAuthenticated() && hasNoPairId(resource.data));
    }

    function pairMembers(pairId) {
      return get(/databases/$(database)/documents/pairs/$(pairId)).data.memberIds;
    }

    // Joiner sets the code owner's pairId in the same transaction that creates the pair.
    function isJoinerLinkingPartner(userId) {
      let pairId = request.resource.data.pairId;
      return isAuthenticated() &&
        request.auth.uid != userId &&
        hasNoPairId(resource.data) &&
        pairId is string &&
        exists(/databases/$(database)/documents/pairs/$(pairId)) &&
        request.auth.uid in pairMembers(pairId) &&
        userId in pairMembers(pairId);
    }

    function isConsumingPairCode() {
      return isAuthenticated() &&
        request.resource.data.used == true &&
        (!('used' in resource.data) || resource.data.used == false);
    }

    match /users/{userId} {
      allow read: if canReadUser(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isJoinerLinkingPartner(userId);
      allow delete: if false;
    }

    match /pairCodes/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.ownerId == request.auth.uid || isConsumingPairCode());
      allow delete: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;
    }

    match /pairs/{pairId} {
      allow read: if isPairedMember(pairId);
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.memberIds.size() == 2;
      allow update, delete: if false;

      match /locations/{uid} {
        allow read: if isPairedMember(pairId);
        allow write: if isPairedMember(pairId) && request.auth.uid == uid;
      }

      match /messages/{messageId} {
        allow read: if isPairedMember(pairId);
        allow create: if isPairedMember(pairId) &&
          request.resource.data.senderId == request.auth.uid;
        allow update: if isPairedMember(pairId);
        allow delete: if false;
      }

      match /presence/{uid} {
        allow read: if isPairedMember(pairId);
        allow write: if isPairedMember(pairId) && request.auth.uid == uid;
      }

      match /typing/{uid} {
        allow read: if isPairedMember(pairId);
        allow write: if isPairedMember(pairId) && request.auth.uid == uid;
      }

      match /readStatus/{uid} {
        allow read: if isPairedMember(pairId);
        allow write: if isPairedMember(pairId) && request.auth.uid == uid;
      }

      match /groceryItems/{itemId} {
        allow read: if isPairedMember(pairId);
        allow create: if isPairedMember(pairId) &&
          request.resource.data.addedBy == request.auth.uid;
        allow update, delete: if isPairedMember(pairId);
      }

      match /periodData/{uid} {
        allow read: if isPairedMember(pairId);
        allow write: if isPairedMember(pairId) && request.auth.uid == uid;
      }
    }
  }
}
